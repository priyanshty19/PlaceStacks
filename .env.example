# ─── Google Maps ─────────────────────────────────────────────────────────────
# Two keys are required, because one key cannot do both jobs.
#
# 1. Browser key — inlined into the client bundle, so restrict it by HTTP
#    referrer (add http://localhost:5173/* for local development).
#    Needs: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# 2. Server key — used by the Express proxy. Google rejects referrer-restricted
#    keys on these web services because a server sends no Referer header, so
#    leave this key unrestricted or restrict it by IP.
#    Needs: Geocoding API, Places API (New)
GOOGLE_MAPS_SERVER_KEY=

# ─── AI providers ────────────────────────────────────────────────────────────
# Server-only: no VITE_ prefix, so these are never bundled into the browser.

# Required — drafts the itinerary. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — refines the draft. Skipped gracefully if absent.
# https://console.groq.com/keys
GROQ_API_KEY=
